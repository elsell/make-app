package s3

import (
	"__MODULE__/modules/media/blob"
	"context"
	"encoding/base64"
	"encoding/json"
	"io"
	"net/http"
	"strings"
	"testing"
	"time"
)

type storageTransport struct {
	status   int
	requests []*http.Request
}

func (t *storageTransport) RoundTrip(r *http.Request) (*http.Response, error) {
	t.requests = append(t.requests, r)
	return &http.Response{StatusCode: t.status, Header: http.Header{}, Body: io.NopCloser(strings.NewReader("")), Request: r}, nil
}
func TestS3PolicyAndExclusivePublication(t *testing.T) {
	transport := &storageTransport{status: 200}
	s, err := New(Config{Endpoint: "s3.example.com", AccessKey: "access", SecretKey: "secret", Bucket: "media", Region: "us-east-1", MaxBytes: 100, Transport: transport})
	if err != nil {
		t.Fatal(err)
	}
	now := time.Now()
	upload := blob.Upload{Owner: "alice", Key: "quarantine/random", PublishedKey: "published/random", Size: 20, ContentType: "image/png", ExpiresAt: now.Add(time.Minute)}
	endpoint, fields, err := s.DirectUpload(context.Background(), upload, now)
	if err != nil || !strings.HasPrefix(endpoint, "https://") {
		t.Fatalf("policy: %s %v", endpoint, err)
	}
	policy, err := base64.StdEncoding.DecodeString(fields["policy"])
	if err != nil {
		t.Fatal(err)
	}
	var decoded map[string]any
	if json.Unmarshal(policy, &decoded) != nil {
		t.Fatal("invalid policy")
	}
	text := string(policy)
	for _, expected := range []string{"content-length-range", "20", "quarantine/random", "image/png"} {
		if !strings.Contains(text, expected) {
			t.Fatalf("missing policy bound %s", expected)
		}
	}
	upload.Size = 101
	if _, _, err := s.DirectUpload(context.Background(), upload, now); err == nil {
		t.Fatal("oversized upload accepted")
	}
	if err := s.Put(context.Background(), "published/object", "text/plain", []byte("data")); err != nil {
		t.Fatal(err)
	}
	if len(transport.requests) == 0 || transport.requests[len(transport.requests)-1].Header.Get("If-None-Match") != "*" {
		t.Fatal("publication can overwrite")
	}
	transport.status = 403
	if _, err := s.Get(context.Background(), "private"); err == nil || strings.Contains(err.Error(), "secret") {
		t.Fatal("unsafe provider failure")
	}
}
