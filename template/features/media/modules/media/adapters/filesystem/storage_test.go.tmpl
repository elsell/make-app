package filesystem

import (
	"__MODULE__/modules/media/blob"
	"context"
	"os"
	"path/filepath"
	"testing"
)

func TestRootedStorageAndBounds(t *testing.T) {
	root := t.TempDir()
	outside := t.TempDir()
	_ = os.WriteFile(filepath.Join(outside, "secret"), []byte("secret"), 0600)
	_ = os.Symlink(outside, filepath.Join(root, "escape"))
	store, err := New(root, 5)
	if err != nil {
		t.Fatal(err)
	}
	defer store.Close()
	ctx := context.Background()
	for _, key := range []blob.Key{"../secret", "escape/secret"} {
		if _, err := store.Get(ctx, key); err == nil {
			t.Fatal("escaped storage root")
		}
	}
	key := blob.Key("owner/file")
	if err := store.Put(ctx, key, "text/plain", []byte("hello")); err != nil {
		t.Fatal(err)
	}
	if err := store.Put(ctx, key, "text/plain", []byte("other")); err == nil {
		t.Fatal("replaced immutable object")
	}
	if err := store.Put(ctx, "large", "text/plain", []byte("larger")); err == nil {
		t.Fatal("oversized write")
	}
	data, err := store.Get(ctx, key)
	if err != nil || string(data) != "hello" {
		t.Fatalf("read: %s %v", data, err)
	}
	if err := store.Delete(ctx, key); err != nil {
		t.Fatal(err)
	}
	if err := store.Delete(ctx, key); err != nil {
		t.Fatal("non-idempotent deletion")
	}
}
